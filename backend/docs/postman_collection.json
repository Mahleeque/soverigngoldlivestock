{
  "info": {
    "name": "Sovereign Gold Livestock API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\":\"Amina\",\"lastName\":\"Okafor\",\"email\":\"amina@example.com\",\"phone\":\"+2348012345678\",\"password\":\"StrongPass123\"}"
        }
      }
    },
    {
      "name": "List Animals",
      "request": { "method": "GET", "url": "{{baseUrl}}/animals?category=ram&page=1&limit=12" }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"animal\":\"000000000000000000000000\",\"quantity\":1}],\"deliveryAddress\":{\"fullName\":\"Amina Okafor\",\"phone\":\"+2348012345678\",\"addressLine\":\"12 Admiralty Way\",\"city\":\"Lekki\",\"state\":\"Lagos\"}}"
        }
      }
    }
  ]
}
